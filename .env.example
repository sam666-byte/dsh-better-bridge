# Configuration for the chatbrain relay (relay/relay2.py) and the session
# extractor (relay/extract.py). These are plain environment variables — export
# them in your shell or service unit; the scripts do not read a .env file.
# Every value below is a placeholder/default, never a real credential.

# Port the OpenAI-compatible relay listens on (loopback only).
CHATBRAIN_PORT=20232

# Where the extracted web session {token, cookies} lives.
# THIS FILE IS A LIVE ACCOUNT TOKEN once generated — chmod 600, never commit.
CHATBRAIN_SESSION_FILE=./.websession.json

# Relay logs (the replies log contains raw model output — treat as private).
CHATBRAIN_LOG_FILE=./relay2.log
CHATBRAIN_REPLIES_LOG=./relay2-replies.log

# Dedicated Firefox profile used for the manual DeepSeek login + extraction.
CHATBRAIN_FF_PROFILE=./ff-profile

# Firefox binary and geckodriver for the extractor (Selenium).
FIREFOX_BIN=/usr/bin/firefox
GECKODRIVER_PATH=geckodriver
